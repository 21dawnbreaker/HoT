package RewardsObjectsBridge

import HashSet

import Utilities


let objects_set = new HashSet<int>


init
    objects_set.add(0) // gnomes in cave

    gg_trg_WurstBridge.addAction() ->
        if udg_wurst_rewards_object

            udg_wurst_rewards_object = false
            
            let pos = vec2(GetLocationX(udg_wurstLoc), GetLocationY(udg_wurstLoc))
            let object = objects_set.getRandomElement()

            if object == 0
                createUnit(NEUTRAL_PASSIVE_PLAYER, 'h02I', pos)
            
            RemoveLocation(udg_wurstLoc)
