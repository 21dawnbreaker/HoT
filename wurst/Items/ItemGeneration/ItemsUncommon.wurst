@compiletime function genRagingAxeItem()
    new ItemDefinition(RAGING_AXE_ITEM_ID, ORIGIN_ITEM_ID)
        ..setName("|cffff0000Топор Гнева|r")..setTooltipBasic("|cffff0000Топор Гнева|r")
        ..setTooltipExtended("+40 к силе и ловкости. |n+15% к физическому урону. |n|n|cffff0000Когда герой получает предмет, его мировоззрение навсегда изменяется на -1. |nНельзя выбросить. Выпадает после смерти|r.")
        ..setDescription("+40 к силе и ловкости. |n15% к физическому урону. |n|n|cffff0000Когда герой получает предмет, его мировоззрение навсегда изменяется на -1. |nНельзя выбросить. Выпадает после смерти|r." + classification_weapon_string)
        ..setLevel(uncommon)..setLevelUnclassified(uncommon)..setIncludeAsRandomChoice(true)
        ..setTintingColor1Red(255)..setTintingColor2Green(180)..setTintingColor3Blue(120)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNFireAxe.blp")..setModelUsed("BattleAxe.mdx")..setScalingValue(1)
        ..setCanBeDropped(false)..setCanBeSoldByMerchants(true)..setCanBeSoldToMerchants(true)..setDroppedWhenCarrierDies(true)
        ..setAbilities(PHYSICAL_AMP_15_SPELL_ID.toRawCode() + ",A0JG")
        ..setActivelyUsed(false)
        ..setCooldownGroup(ORIGIN_ITEM_ID.toRawCode())
        ..setClassification(weapon)
        ..setGoldCost(UNCOMMON_ITEM_GOLD_PRICE)

