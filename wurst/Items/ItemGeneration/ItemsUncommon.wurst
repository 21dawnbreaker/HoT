@compiletime function genStoneGlovesItem()
    new ItemDefinition(STONE_GLOVES_ITEM_ID, ORIGIN_ITEM_ID)
        ..setName("|cff80ff80Каменные перчатки|r")..setTooltipBasic("|cff80ff80Каменные перчатки|r")
        ..setTooltipExtended("+8 к броне. |n+5% к сопротивлению всем видам урона. |nСпособность: \"|cffd45e19Провокация|r\" - заставляет выбранную цель атаковать вас. Перезарядка - |cffff000015 сек|r.")
        ..setDescription("+8 к броне. |n+5% к сопротивлению всем видам урона. |nСпособность: \"|cffd45e19Провокация|r\" - заставляет выбранную цель атаковать вас. Перезарядка - |cffff000015 сек|r." + classification_gloves_string)
