package CloakOfInsanity

import ChannelAbilityPreset
import public Assets
import public BuffObjEditing
import DamageEvent

public constant CLOAK_OF_INSANITY_SPELL_ID = compiletime(ABIL_ID_GEN.next())
public constant FLASH_EFFECT = Abilities.feralspirittarget

let MAX_DAMAGE_BONUS = 2.0

@compiletime function genObj()
    new AbilityDefinitionStormHammers(CLOAK_OF_INSANITY_SPELL_ID)
        ..setRequirements("")


init
    DamageEvent.addListener() -> 
        if DamageEvent.getSource().hasAbility(CLOAK_OF_INSANITY_SPELL_ID) and (DamageEvent.getAttackType() == ATTACK_TYPE_CHAOS or DamageEvent.getAttackType() == ATTACK_TYPE_MAGIC or DamageEvent.getAttackType() == ATTACK_TYPE_NORMAL)
            let dmg = DamageEvent.getAmount() * GetRandomReal(0.01, MAX_DAMAGE_BONUS)

            DamageEvent.setAmount(dmg)
            DamageEvent.setAttackType(ATTACK_TYPE_CHAOS)