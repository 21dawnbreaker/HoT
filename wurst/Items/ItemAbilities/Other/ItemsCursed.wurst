package ItemsCursed

import ClosureEvents
import HashSet

import ItemsUncommon
import ItemsRare
import ItemsEpic
import ItemsLegendary

let _cursedItemsList = [
    'I095',
    'I09H',
    'I09Q',
    RAGING_AXE_ITEM_ID,
    CLOAK_OF_INSANITY_ITEM_ID
]

public let CURSED_ITEMS_SET = new HashSet<int>

public function isCursed(item itm) returns bool
    return CURSED_ITEMS_SET.has(itm.getTypeId())

public function unableToEquipCursedItems(unit u) returns bool
    return u.hasAbility('A08F')

public function doAlignmentDamage(unit u, player plyer)
    for i = 1 to udg_HeroNumber
        if plyer == udg_Hero[i].getOwner()
            udg_Karma[i] -= 1
            udg_KarmaU = u
            TriggerExecute(gg_trg_KarmaSystem)
            udg_KarmaU = null
            break


init
    for i = 0 to _cursedItemsList.length -1
        CURSED_ITEMS_SET.add(_cursedItemsList[i])
        