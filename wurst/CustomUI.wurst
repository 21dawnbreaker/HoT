package CustomUI

import ClosureTimers

function return_idle_workers_frames()
    let idle_workers = BlzFrameGetChild(BlzGetFrameByName("ConsoleBottomBar", 0), 3)

    idle_workers.setVisible(true)
    idle_workers.clearAllPoints()
    idle_workers.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.003, 0.08) // 0.02, 0.17

function change_system_msg_frame_pos()
    let frame = BlzGetOriginFrame(ORIGIN_FRAME_UNIT_MSG, 0)

    frame.clearAllPoints()
    frame.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.000212200, 0.500000)
    frame.setAbsPoint(FRAMEPOINT_BOTTOMRIGHT, 0.500000, 0.340000)


init
    doAfter(0.1) -> 
        change_system_msg_frame_pos()

    doAfter(3) ->
        return_idle_workers_frames()
