package DemoralizingShout

import ClosureEvents
import HashSet
import SoundUtils

let shouts_set = new HashSet<SoundDefinition>..add(
    new SoundDefinition("Sounds\\battlecry1.mp3", false, true),
    new SoundDefinition("Sounds\\battlecry2.mp3", false, true),
    new SoundDefinition("Sounds\\battlecry3.mp3", false, true)
)

init
    EventListener.onCast('ANht') (unit caster) ->
        shouts_set.getRandomElement().playOnPoint(caster.getPos3Real())
