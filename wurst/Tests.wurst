package Tests
import ClosureEvents
import ClosureForGroups

import ItemCraftRecipes
import ItemClassifications
import ItemsUncommon
import ItemsRunesAndGems
import ItemsRare
import ItemsEpic
import ItemsLegendary
import Utilities
import Overpower


init
    EventListener.add(EVENT_PLAYER_CHAT_FILTER) ->
        let msg = GetEventPlayerChatString()
        let _player = GetTriggerPlayer()
        let _hero = udg_hero_by_player[_player.getId() + 1]

        if msg == "-test4"
            createUnit(NEUTRAL_PASSIVE_PLAYER, 'h02K', _hero.getPos())
            
        if msg == "-test5"
            for itm in TWO_ITEM_CRAFTS
                CreateItem(itm.itemA, _hero.getX(), _hero.getY())
                CreateItem(itm.itemB, _hero.getX(), _hero.getY())

            
        if msg == "-test6"
            TriggerExecute(gg_trg_ObjectRewardingGeneral)

        if msg == "-gnomes"
            createUnit(NEUTRAL_PASSIVE_PLAYER, 'h02I', _hero.getPos())

        if msg == "-msg"
            print("Message!")

        if msg == "-m"
            forUnitsInRect(gg_rct_BossfightInnerLoc) u ->
                u.addMana(u.getMaxMana())

        if msg == "-legendary"
            CreateItem(ChooseRandomItem(legendary), _hero.getX(), _hero.getY())

        if msg == "-randitem"
            CreateItem(ChooseRandomItem(GetRandomInt(1, 7)), _hero.getX(), _hero.getY())

        if msg == "-gems"
            for gem in GEMS
                CreateItem(gem.itemId, _hero.getX(), _hero.getY())